<svg font-family="-apple-system-body, ui-sans-serif, -apple-system, system-ui, Segoe UI, Helvetica, Apple Color Emoji, Arial, sans-serif, Segoe UI Emoji, Segoe UI Symbol" font-weight="400" data-d-component="svg" fill="currentColor" style="color:rgb(13, 13, 13)" viewBox="0 0 340 185" width="100%" xmlns="http://www.w3.org/2000/svg"><circle cx="40" cy="38" r="24" fill="#DBEAFE" stroke="#2563EB" stroke-width="1.5"/><text x="40" y="43" font-size="13" fill="#1D4ED8" text-anchor="middle">x₁=1</text><circle cx="40" cy="140" r="24" fill="#DBEAFE" stroke="#2563EB" stroke-width="1.5"/><text x="40" y="145" font-size="13" fill="#1D4ED8" text-anchor="middle">x₂=1</text><path d="M64 38 L170 83 M64 140 L170 97" stroke="currentColor" stroke-width="1.7" fill="none"/><text x="111" y="45" font-size="12" fill="#0D9488" text-anchor="middle">w₁=1</text><text x="111" y="137" font-size="12" fill="#0D9488" text-anchor="middle">w₂=1</text><circle cx="205" cy="90" r="35" fill="#D1FAE5" stroke="#059669" stroke-width="2"/><text x="205" y="86" font-size="12" fill="#047857" text-anchor="middle">Neuron</text><text x="205" y="101" font-size="12" fill="#047857" text-anchor="middle">b = −1.5</text><path d="M240 90 L294 90" stroke="currentColor" stroke-width="1.7"/><path d="M287 85 L296 90 L287 95" stroke="currentColor" stroke-width="1.7" fill="none"/><text x="314" y="85" font-size="15" fill="currentColor" text-anchor="middle">y=1</text><text x="310" y="109" font-size="10" fill="currentColor" text-anchor="middle">z ≥ 0</text><text x="170" y="174" font-size="11" fill="currentColor" text-anchor="middle">The bias is a parameter inside the neuron.</text></svg>